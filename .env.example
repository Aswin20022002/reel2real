# ---------- Optional: makes reel analysis + Copilot use a real LLM ----------
# Any OpenAI-compatible endpoint works. Defaults below are Groq (free tier available).
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_WHISPER_MODEL=whisper-large-v3-turbo

# ---------- Optional: live place status, recent reviews and photos ----------
# Google Cloud -> enable "Places API (New)" -> create an API key (server-side use only)
GOOGLE_PLACES_API_KEY=

# ---------- Optional: real multi-device groups (shared itinerary + expenses) ----------
# Supabase -> Project settings -> API. Run supabase/schema.sql first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
